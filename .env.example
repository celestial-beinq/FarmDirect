# Copy this file to ".env" and fill it in. ".env" is git-ignored.
#
# ONLY public values belong here. Both of these are designed to be visible
# in the browser; what protects your data is Row Level Security in the
# database, not hiding these.
#
# NEVER put the Supabase service_role key or the Paystack secret key here.
# Those go to the server with `supabase secrets set` (see SETUP.md).

# Supabase dashboard → Project Settings → API → Project URL
SUPABASE_URL=

# Supabase dashboard → Project Settings → API → anon / publishable key
SUPABASE_ANON_KEY=
