# Secrets for the edge functions. These live on the SERVER only.
#
# Local testing:  copy this file to supabase/functions/.env  (it is git-ignored)
# Production:     supabase secrets set PAYSTACK_SECRET_KEY=... SITE_URL=... ALLOWED_ORIGINS=...
#
# Never put these values in the Angular app or in the root .env file.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to functions automatically.

# Paystack secret key (starts with sk_test_ or sk_live_)
PAYSTACK_SECRET_KEY=

# Where customers return to after paying
SITE_URL=http://localhost:4200

# Sites allowed to call the functions (comma separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:4200
